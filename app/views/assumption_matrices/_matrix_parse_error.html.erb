<div class="alert alert-warning"
     data-controller="generating"
     data-action="turbo:submit-start->generating#start turbo:submit-end->generating#stop">
  <strong>The AI returned a response that could not be parsed.</strong>
  <p class="mb-2">
    This happens when the model deviates from the expected JSON schema. Click Retry to
    try again, or edit the template in the admin panel to tighten the instructions.
  </p>
  <div data-generating-target="form">
    <%= button_to "Retry",
          strategy_product_assumption_matrices_path(strategy_product),
          method: :post,
          class: "btn btn-outline-warning btn-sm" %>
  </div>
  <div data-generating-target="overlay" class="d-none mt-1">
    <div class="d-flex align-items-center gap-3">
      <div class="spinner-border spinner-border-sm" role="status">
        <span class="visually-hidden">Generating…</span>
      </div>
      <span>Generating your assumption matrix&hellip;</span>
      <%= link_to "Cancel", strategy_product_path(strategy_product),
            class: "btn btn-sm btn-outline-warning" %>
    </div>
  </div>
</div>

<% if matrix.gemini_raw.present? %>
  <div class="mt-3">
    <p class="text-muted small mb-1">Raw response from Gemini:</p>
    <pre class="small p-3 rounded" style="background: var(--bs-body-bg); border: 1px solid var(--bs-border-color);"><%= matrix.gemini_raw %></pre>
  </div>
<% end %>
