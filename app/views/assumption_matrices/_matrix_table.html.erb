<div data-controller="matrix-sort">
  <div class="btn-group mb-3" role="group" aria-label="Sort assumptions">
    <button type="button" class="btn btn-outline-secondary btn-sm active"
            data-action="click->matrix-sort#sortByLeverage">Leverage</button>
    <button type="button" class="btn btn-outline-secondary btn-sm"
            data-action="click->matrix-sort#sortByRisk">Risk</button>
    <button type="button" class="btn btn-outline-secondary btn-sm"
            data-action="click->matrix-sort#sortByGap">Confidence Gap</button>
  </div>

  <div class="table-responsive">
    <table class="table table-dark table-hover table-striped align-middle"
           data-matrix-sort-target="table">
      <thead>
        <tr>
          <th style="width: 30%">Assumption</th>
          <th>AI Confidence</th>
          <th>Your Confidence</th>
          <th>Risk</th>
          <th>Category</th>
          <th>Experiment</th>
          <th class="d-none gap-col">Gap</th>
        </tr>
      </thead>
      <tbody>
        <% assumptions.each do |assumption| %>
          <tr data-download-markdown-target="row"
              data-position="<%= assumption.position %>"
              data-risk="<%= assumption.risk %>"
              data-gap="<%= assumption.confidence_gap&.abs || 0 %>"
              data-statement="<%= assumption.statement %>"
              data-confidence-ai="<%= assumption.confidence_ai %>"
              data-confidence-user="<%= assumption.confidence_user || 0 %>"
              data-category="<%= assumption.category %>"
              data-experiment="<%= assumption.experiment %>">

            <td><%= assumption.statement %></td>

            <td class="text-nowrap">
              <% 5.times do |i| %>
                <span class="<%= i < assumption.confidence_ai ? 'text-warning' : 'text-secondary' %>">●</span>
              <% end %>
            </td>

            <td>
              <%= render "assumptions/confidence_rating", assumption: assumption %>
            </td>

            <td>
              <% badge_class = { "low" => "bg-success", "medium" => "bg-warning text-dark", "high" => "bg-danger" } %>
              <span class="badge <%= badge_class[assumption.risk] %>"><%= assumption.risk %></span>
            </td>

            <td>
              <span class="badge bg-secondary"><%= assumption.category %></span>
            </td>

            <td class="small text-muted"><%= assumption.experiment %></td>

            <td class="d-none gap-col">
              <%= turbo_frame_tag "assumption_#{assumption.id}_gap" do %>
                <%= render "assumptions/confidence_gap", assumption: assumption %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
