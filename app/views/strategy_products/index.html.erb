<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My Products</h1>
  <%= link_to "New product", new_strategy_product_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @strategy_products.empty? %>
  <div class="text-center py-5">
    <p class="text-muted mb-3">You haven&rsquo;t added a product yet.</p>
    <%= link_to "Create your first product", new_strategy_product_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <div class="row g-3">
    <% @strategy_products.each do |product| %>
      <div class="col-12">
        <%= link_to strategy_product_path(product), class: "text-decoration-none" do %>
          <div class="card card-hover">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title mb-1"><%= product.name %></h5>
                  <p class="text-muted small mb-2"><%= truncate(product.target_customer, length: 80) %></p>
                </div>
                <div class="text-end text-muted small ms-3 flex-shrink-0">
                  <% if product.latest_matrix %>
                    <div><%= product.latest_matrix.assumptions.count %> assumptions</div>
                    <div><%= time_ago_in_words(product.latest_matrix.generated_at) %> ago</div>
                  <% else %>
                    <div class="fst-italic">no matrix yet</div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
